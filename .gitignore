# Publish only the application and its build inputs; keep local research intact.
/*
!/.gitignore
!/README.md
!/project.yml
!/ddc-key.swift
!/build-app.sh
!/App/
/App/*
!/App/Host/
!/App/Control/
!/App/Shared/
!/App/Tests/
!/scripts/
!/Vendor/
/Vendor/*
!/Vendor/AppleSiliconDDC/
!/.github/
/.github/*
!/.github/workflows/

# XcodeGen owns this file; its complete contents live in project.yml.
/App/Control/Info.plist

# Explicitly keep the local plan, hardware snapshots and experiments private.
/PLAN.md
/AGENTS.md
/AppleSiliconDDC/
/App/*.json
/ddc-scan*
/ddc-write-test.py
/gamma-*

# Build products and machine-specific configuration are never source inputs.
.DS_Store
DerivedData/
.build/
.build-app/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.app/
*.appex/
*.dSYM/
*.o
*.a
*.dylib
*.zip
*.tar
*.tar.gz
*.dmg
*.pkg

# Signing material and local environment files stay outside the repository.
.env
.env.*
*.p12
*.pfx
*.pem
*.key
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.local
*.xcsettings
*.cert
